<?xml version="1.0" encoding="UTF-8"?>
<!--
  پیکربندی IIS برای سامانه احراز هویت یکپارچه (SSO)

  پیش‌نیازها:
    - PHP 8 از طریق FastCGI
    - ماژول URL Rewrite (برای مسیرهای /api/v1/*)

  نکته‌ی مهم:
    Document Root سایت در IIS Manager باید روی پوشه‌ی public تنظیم شود.
    در آن صورت پوشه‌های src، config، storage، database، tools و tests
    اساساً بیرون از ریشه‌ی وب قرار می‌گیرند و قوانینِ مسدودسازیِ این فایل
    فقط یک لایه‌ی دفاعیِ اضافه‌اند.
-->
<configuration>
  <system.webServer>

    <!-- ================== PHP FastCGI ================== -->
    <!--
      اگر PHP را در مسیر دیگری نصب کرده‌اید، مقدار scriptProcessor را اصلاح کنید.
      اگر PHP در سطح سرور (IIS Manager > Handler Mappings) از قبل ثبت شده،
      این بلوک را حذف کنید تا تداخلی ایجاد نشود.
    -->
    <handlers>
      <add name="PHP_via_FastCGI"
           path="*.php"
           verb="GET,HEAD,POST,PUT,PATCH,DELETE,OPTIONS"
           modules="FastCgiModule"
           scriptProcessor="C:\php\php-cgi.exe"
           resourceType="Unspecified"
           requireAccess="Script" />
    </handlers>

    <!-- ================== اسناد پیش‌فرض ================== -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
        <add value="index.html" />
        <add value="index.htm" />
        <add value="Default.htm" />
        <add value="iisstart.htm" />
      </files>
    </defaultDocument>

    <!-- ================== بازنویسی URL ================== -->
    <rewrite>
      <rules>
        <!--
          API: /api/v1/... -> /api/index.php
          این قانون برای کارکرد مسیرهای API ضروری است.
          اگر ماژول URL Rewrite نصب نیست، از /api/index.php?_route=/v1/users استفاده کنید.
        -->
        <rule name="SsoApiRewrite" stopProcessing="true">
          <match url="^api/v1/(.*)$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="api/index.php" appendQueryString="true" />
        </rule>

        <!--
          مسدود کردن پوشه‌های داخلی (در صورتی که سایت در ریشه‌ی پروژه منتشر شود).
          به‌جای هدایت، پاسخ ۴۰۴ داده می‌شود تا وجود این مسیرها معلوم نشود.
        -->
        <rule name="SsoBlockInternal" stopProcessing="true">
          <match url="^(src|config|storage|database|tests|tools|docs|data|includes|app)/(.*)$" ignoreCase="true" />
          <action type="CustomResponse"
                  statusCode="404"
                  statusReason="Not Found"
                  statusDescription="Not Found" />
        </rule>

        <!--
          در این پروژه از Front Controller استفاده نشده است: صفحات پنل مدیریت
          مسیرهای واقعی هستند (‎/admin/users.php، ‎/setup.php، ‎/assets/app.css و ...)
          و index.php فقط به /admin یا /setup.php هدایت می‌کند.
          بنابراین قانونِ «همه‌چیز به index.php» اینجا لازم نیست و در صورت افزودن،
          صفحات پنل را خراب می‌کند.
        -->
      </rules>
    </rewrite>

    <!-- ================== خطاهای HTTP ================== -->
    <!--
      در production از Detailed استفاده نکنید: جزئیات استثناها و مسیرهای فایل
      را برای کل اینترنت فاش می‌کند. جزئیات فقط برای localhost نمایش داده می‌شود؛
      خطای واقعی در storage/logs/app.log ثبت می‌گردد.
    -->
    <httpErrors errorMode="DetailedLocalOnly" />

    <!-- ================== امنیت و فیلتر درخواست ================== -->
    <security>
      <requestFiltering>
        <!-- سقف حجم درخواست: ۱۰ مگابایت (این سامانه فایل آپلود نمی‌کند) -->
        <requestLimits maxAllowedContentLength="10485760" />

        <!-- پوشه‌های داخلی از بیرون قابل دسترسی نباشند -->
        <hiddenSegments>
          <add segment="src" />
          <add segment="config" />
          <add segment="storage" />
          <add segment="database" />
          <add segment="tests" />
          <add segment="tools" />
          <add segment="docs" />
          <add segment="data" />
          <add segment="includes" />
          <add segment="app" />
          <add segment=".git" />
        </hiddenSegments>

        <!--
          پسوندهایی که هرگز نباید سرو شوند.
          توجه: این سامانه هیچ فایل JSON ایستا سرو نمی‌کند (پاسخ‌های JSON
          توسط PHP تولید می‌شوند و مشمول این فیلتر نیستند).
          اگر بعداً داراییِ استاتیک مانند manifest.json به public اضافه کردید،
          خط مربوط به .json را از این فهرست حذف کنید.
        -->
        <fileExtensions>
          <add fileExtension=".sql"     allowed="false" />
          <add fileExtension=".sqlite"  allowed="false" />
          <add fileExtension=".json"    allowed="false" />
          <add fileExtension=".lock"    allowed="false" />
          <add fileExtension=".log"     allowed="false" />
          <add fileExtension=".md"      allowed="false" />
          <add fileExtension=".env"     allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <!-- ================== محتوای ایستا (MIME) ================== -->
    <staticContent>
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff"  mimeType="font/woff" />
      <remove fileExtension=".ttf" />
      <mimeMap fileExtension=".ttf"   mimeType="font/ttf" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp"  mimeType="image/webp" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg"   mimeType="image/svg+xml" />

      <!-- کش یک‌هفته‌ای برای فایل‌های ایستا -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
    </staticContent>

    <!-- ================== فشرده‌سازی ================== -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <!-- ================== هدرهای امنیتی ================== -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="geolocation=(), microphone=(), camera=()" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>
